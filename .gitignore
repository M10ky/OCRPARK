# =========================================================================
# SM-Park - .gitignore
# =========================================================================

# --- Secrets / environnement ---
.env
.env.local
.env.*.local
*.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js ---
node_modules/
.next/
out/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
*.tsbuildinfo

# --- Docker ---
*.pid
docker-compose.override.yml
/data/
/volumes/

# --- Données / runtime ---
*.log
logs/
captures/
crops/
snapshots/
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg

# --- Modèles OCR / IA (trop volumineux pour Git) ---
ocr-service/models/
*.pth
*.onnx
*.pt
.vlm/

# --- IDE / Éditeurs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- PlatformIO (firmware ESP32) ---
firmware/esp32/.pio/
firmware/esp32/.pioenvs/
.pio/
