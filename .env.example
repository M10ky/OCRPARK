# =========================================================================
# SM-Park - Variables d'environnement (EXEMPLE)
# -------------------------------------------------------------------------
# Copier ce fichier vers .env puis adapter les valeurs :
#     cp .env.example .env
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# =========================================================================

# -------------------------------------------------------------------------
# Général
# -------------------------------------------------------------------------
PROJECT_NAME=SM-Park
ENVIRONMENT=development
TZ=Indian/Antananarivo

# -------------------------------------------------------------------------
# PostgreSQL (conteneur: database)
# -------------------------------------------------------------------------
POSTGRES_USER=smpark
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=smpark
POSTGRES_HOST=database
POSTGRES_PORT=5432
# DSN utilisée par le backend (SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://smpark:change_me_postgres@database:5432/smpark

# -------------------------------------------------------------------------
# Broker MQTT - Eclipse Mosquitto (conteneur: mqtt-broker)
# -------------------------------------------------------------------------
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_USERNAME=smpark
MQTT_PASSWORD=change_me_mqtt
MQTT_CLIENT_ID=backend-smpark
# Topics utilisés par le système (référence)
MQTT_TOPIC_PARKING_STATE=smpark/parking/state
MQTT_TOPIC_PARKING_EVENTS=smpark/parking/events
MQTT_TOPIC_BARRIER_CMD=smpark/barrier/command
MQTT_TOPIC_BARRIER_STATE=smpark/barrier/state

# -------------------------------------------------------------------------
# Backend FastAPI (conteneur: backend)
# -------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_me_super_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------------
# Service OCR (conteneur: ocr-service)
# -------------------------------------------------------------------------
OCR_HOST=0.0.0.0
OCR_PORT=8001
OCR_CAMERA_INDEX=0
OCR_CONFIDENCE_THRESHOLD=0.5

# -------------------------------------------------------------------------
# Frontend Next.js (conteneur: frontend)
# -------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
