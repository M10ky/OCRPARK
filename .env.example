# =========================================================================
# SM-Park - Variables d'environnement (EXEMPLE)
# -------------------------------------------------------------------------
# Copier ce fichier vers .env puis adapter les valeurs :
#     cp .env.example .env
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
#
# Chaque variable est ici lue par : le backend (backend/app/core/config.py),
# le service OCR (ocr-service/app/core/config.py) ou docker-compose.yml.
# Les variables inutiles/dupliquées ont été supprimées (phase A).
# =========================================================================

# -------------------------------------------------------------------------
# Général (compose + backend + OCR)
# -------------------------------------------------------------------------
PROJECT_NAME=SM-Park
ENVIRONMENT=development
TZ=Indian/Antananarivo

# -------------------------------------------------------------------------
# PostgreSQL (compose: database ; backend: DATABASE_URL)
# -------------------------------------------------------------------------
POSTGRES_USER=smpark
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=smpark
POSTGRES_PORT=5432
# DSN utilisée par le backend (SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://smpark:change_me_postgres@database:5432/smpark

# -------------------------------------------------------------------------
# Broker MQTT (compose: mqtt-broker ; backend: config.py)
# -------------------------------------------------------------------------
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_USERNAME=smpark
MQTT_PASSWORD=change_me_mqtt
MQTT_CLIENT_ID=smpark-backend
MQTT_KEEPALIVE=60
# Topics utilisés par le système
MQTT_TOPIC_PARKING_STATE=parking/state
MQTT_TOPIC_PARKING_EVENTS=parking/events
MQTT_TOPIC_BARRIER_COMMAND=parking/barrier/command
MQTT_TOPIC_BARRIER_STATE=barrier/state

# -------------------------------------------------------------------------
# Backend FastAPI (compose: backend ; backend/app/core/config.py)
# -------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Deux WebSocket : false en dev (connexion sans token acceptée),
# true en production (token JWT obligatoire sur /ws/events).
WS_REQUIRE_AUTH=false
# Auth JWT (seules ces variables JWT_* sont lues par le backend)
JWT_SECRET_KEY=change_me_super_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Mot de passe du compte admin créé au premier démarrage. S'il est absent ou
# vaut "admin", AUCUN admin n'est créé (avertissement dans les logs).
ADMIN_INITIAL_PASSWORD=change_me_admin_password
# URL interne du service OCR (vue depuis le conteneur backend)
OCR_SERVICE_URL=http://ocr-service:8001

# -------------------------------------------------------------------------
# Service OCR (compose: ocr-service ; ocr-service/app/core/config.py)
# -------------------------------------------------------------------------
OCR_HOST=0.0.0.0
OCR_PORT=8001
OCR_CAMERA_INDEX=0
OCR_CAMERA_WIDTH=1280
OCR_CAMERA_HEIGHT=720
OCR_LANGUAGES=en
OCR_CONFIDENCE_THRESHOLD=0.5
OCR_ALLOWLIST=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789- 

# -------------------------------------------------------------------------
# Frontend Next.js (compose: frontend, en build args)
# -------------------------------------------------------------------------
# NEXT_PUBLIC_* sont figées AU BUILD : elles alimentent build.args, pas
# l'environnement d'exécution du conteneur.
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
