; =========================================================================
; SM-Park - Secrets locaux du firmware ESP32 (NE PAS COMMITTER)
; -------------------------------------------------------------------------
; Copier ce fichier vers secrets.ini puis renseigner vos valeurs :
;     cp firmware/esp32/secrets.ini.example firmware/esp32/secrets.ini
; secrets.ini est ignoré par git (voir firmware/esp32/.gitignore).
;
; ⚠️ PlatformIO ignore SILENCIEUSEMENT un `extra_configs` introuvable :
;   si secrets.ini est absent, le firmware se compile quand même, mais avec
;   des valeurs de substitution et il ne se connecte jamais. Le firmware
;   detecte ces sentinelles au demarrage et l'affiche sur le moniteur serie.
;
; MQTT_HOST : IP LAN DU PC qui heberge le broker Mosquitto (docker compose).
;   Le broker est publie sur le port 1883 de la machine hote.
; =========================================================================

[env]
build_flags =
    -DWIFI_SSID=\"votre_ssid_wifi\"
    -DWIFI_PASSWORD=\"votre_mot_de_passe_wifi\"
    -DMQTT_HOST=\"192.168.1.100\"
    -DMQTT_PORT=1883
    -DMQTT_USER=\"smpark\"
    -DMQTT_PASSWORD=\"change_me_mqtt\"
    -DMQTT_KEEPALIVE=60
