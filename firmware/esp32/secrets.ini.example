; =========================================================================
; SM-Park - Secrets locaux du firmware ESP32 (NE PAS COMMITTER)
; -------------------------------------------------------------------------
; Copier ce fichier vers secrets.ini puis renseigner vos valeurs :
;     cp firmware/esp32/secrets.ini.example firmware/esp32/secrets.ini
; secrets.ini est ignoré par git (voir .gitignore).
; =========================================================================

[env]
build_flags =
    -DWIFI_SSID=\"votre_ssid_wifi\"
    -DWIFI_PASSWORD=\"votre_mot_de_passe_wifi\"
    -DMQTT_HOST=\"192.168.1.100\"
    -DMQTT_PORT=1883
    -DMQTT_USER=\"smpark\"
    -DMQTT_PASSWORD=\"change_me_mqtt\"
